VITE_API_BASE_URL=http://localhost:3000/api/v1

# Google Maps JS API key. THREE products must be enabled on it, and each fails
# differently and quietly if it is not:
#   · Maps JavaScript API — without it no map renders at all.
#   · Places API          — the map still renders; the location search field just
#                           returns nothing, with no error.
#   · Geocoding API       — everything still works; every saved location displays as
#                           raw coordinates instead of an address.
# Leave the key blank entirely and every map degrades to coordinate entry rather than
# hanging, which is the supported no-maps deployment.
VITE_GOOGLE_MAPS_API_KEY=
